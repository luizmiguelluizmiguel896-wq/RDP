name: Windows-RDP-MaxTime

on:
  push:
    branches: [ "main" ]

jobs:
  build:
    runs-on: windows-latest
    steps:
    - name: Otimizando Windows para Jogos
      run: |
        Set-ItemProperty -Path 'HKLM:\System\CurrentControlSet\Control\Terminal Server' -Name "fDenyTSConnections" -Value 0
        Enable-NetFirewallRule -DisplayGroup "Remote Desktop"
        write-output "Sistema Otimizado!"
    - name: Instalando o StarDesk
      run: |
        $url = "https://stardesk.net"
        $output = "StarDeskSetup.exe"
        [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
        Invoke-WebRequest -Uri $url -OutFile $output -UserAgent "Mozilla/5.0"
        Start-Process -FilePath "StarDeskSetup.exe" -ArgumentList "/S" -Wait
    - name: Mantendo Ativo pelo Limite Maximo (6 Horas)
      run: |
        $loop = 0
        while ($loop -lt 360) {
          Start-Sleep -Seconds 60
          $loop++
        }
